# job_history database configuration
# Copy this file to .env and fill in the values appropriate for your environment.
# .env is gitignored — never commit credentials.

# -------------------------------------------------------------------
# Backend selection: "sqlite" (default) or "postgres"
# -------------------------------------------------------------------
JOB_HISTORY_DB_BACKEND=sqlite

# -------------------------------------------------------------------
# SQLite settings  (used when JOB_HISTORY_DB_BACKEND=sqlite)
# -------------------------------------------------------------------

# Directory containing per-machine database files ({machine}.db).
# Default: ./data relative to the project root.
#JOB_HISTORY_DATA_DIR=./data

# Per-machine path overrides (take precedence over JOB_HISTORY_DATA_DIR):
#QHIST_DERECHO_DB=/path/to/derecho.db
#QHIST_CASPER_DB=/path/to/casper.db

# -------------------------------------------------------------------
# PostgreSQL settings  (used when JOB_HISTORY_DB_BACKEND=postgres)
# -------------------------------------------------------------------

#JOB_HISTORY_PG_HOST=localhost
#JOB_HISTORY_PG_PORT=5432
#JOB_HISTORY_PG_USER=postgres
#JOB_HISTORY_PG_PASSWORD=example

# Require SSL/TLS for the PostgreSQL connection (true/false):
#JOB_HISTORY_PG_REQUIRE_SSL=false

# Per-machine database name overrides.
# Default pattern: {machine}_jobs  (e.g. derecho_jobs, casper_jobs)
#JOB_HISTORY_PG_DERECHO_DB=derecho_jobs
#JOB_HISTORY_PG_CASPER_DB=casper_jobs

# ===================================================================
# fs_scans database configuration
# ===================================================================

# -------------------------------------------------------------------
# Backend selection: "sqlite" (default, local CLI) or "postgres" (webserver).
# -------------------------------------------------------------------
#FS_SCAN_DB_BACKEND=sqlite

# -------------------------------------------------------------------
# SQLite settings (used when FS_SCAN_DB_BACKEND=sqlite)
# -------------------------------------------------------------------
# Directory containing per-collection database files ({collection}.db).
# Default: fs_scans/data relative to the module.
#FS_SCAN_DATA_DIR=./fs_scans/data
# Single explicit database file (overrides FS_SCAN_DATA_DIR):
#FS_SCAN_DB=/path/to/collection.db

# -------------------------------------------------------------------
# PostgreSQL settings (used when FS_SCAN_DB_BACKEND=postgres)
# -------------------------------------------------------------------
#FS_SCAN_PG_HOST=localhost
#FS_SCAN_PG_PORT=5432
#FS_SCAN_PG_USER=postgres
#FS_SCAN_PG_PASSWORD=example
#FS_SCAN_PG_REQUIRE_SSL=false

# Database name = filesystem (one PG database per filesystem; collections are
# schemas inside it). Default: campaign  (the /glade/campaign/ filesystem).
#FS_SCAN_PG_DB=campaign

# Per-collection schema name override (default: lower-cased collection name):
#FS_SCAN_PG_CGD_SCHEMA=cgd
